EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Gemini (backend only)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MEMORY_MODEL=gemini-3.8-flash

# DeepSeek (backend only; set LLM_PROVIDER=deepseek to use it)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MEMORY_MODEL=deepseek-flash

# Groq (backend only; set LLM_PROVIDER=groq to use it)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MEMORY_MODEL=qwen/qwen3.8-27b

# Swiggy MCP (backend only; generate with Fernet.generate_key())
SWIGGY_BASE_URL=https://mcp.swiggy.com
SWIGGY_OAUTH_REDIRECT_URI=http://localhost:8000/api/swiggy/oauth/callback
SWIGGY_CLIENT_ID=
SWIGGY_TOKEN_ENCRYPTION_KEY=
