# Dependencies and package-manager caches
node_modules/
.npm/

# Expo, Metro, and generated web output
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
/.export-check*/
/.dark-mode-android-check/

# Generated native projects and build artifacts
/ios/
/android/
.gradle/
.kotlin/
.cxx/
*.apk
*.aab
*.ipa
*.xcarchive
*.orig.*

# Signing credentials and certificates
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# Local environment files. Keep sanitized templates in Git.
.env
.env.*
!.env.example
!**/.env.example

# Python virtual environments, caches, and test output
.venv/
venv/
.uv-cache*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
__pycache__/
*.py[cod]
*.egg-info/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local databases and runtime state
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Logs and temporary files
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
*.tmp
*.temp

# Local archives and packaged copies (can accidentally contain .env files)
*.zip
*.7z
*.tar
*.tar.gz
*.tgz

# TypeScript build state
*.tsbuildinfo

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
